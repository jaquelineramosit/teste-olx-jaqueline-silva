# Copie para .env e ajuste se necessário. Valores apenas para ambiente local — não são credenciais reais.
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_PORT=5432
APP_PORT=8080

# Variáveis lidas pela aplicação (ver src/main/resources/application.yml)
# DB_URL=jdbc:postgresql://localhost:5432/marketplace
# MODERATION_BASE_URL=http://localhost:8787
# MODERATION_READ_TIMEOUT=2500ms
# MODERATION_MAX_ATTEMPTS=3
# MODERATION_RETRY_INTERVAL=PT30S
